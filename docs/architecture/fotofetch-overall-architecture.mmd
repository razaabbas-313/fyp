            BE_SecFilter["Spring Security Filter Chain<br/><i>Stateless Session Policy, CORS</i>"]:::implemented
            BE_JWT["JWT Token Provider & Filter<br/><i>Bearer Token Validation</i>"]:::implemented
            BE_RBAC["5-Role RBAC & Tenant Guard<br/><i>Role-Based Access Control</i>"]:::partial
            BE_GuestSession["Guest Session Guard<br/><i>SHA-256 Token Hash & Download Authorizer</i>"]:::implemented
        end

        subgraph M_Tenant ["B. Studio & Tenant Management"]
            BE_TenantScoping["Tenant Scoping & Isolation<br/><i>Current: User-scoped Event Ownership</i>"]:::partial
            BE_StudioMgmt["Studio Entity & Multi-Tenant Isolation<br/><i>Studio Data Boundaries</i>"]:::proposed
            BE_WalletMgmt["Studio Billing & Prepaid Wallet<br/><i>Credit Balance & Usage Metering</i>"]:::proposed
        end

        subgraph M_Event ["C. Event Management"]
            BE_EventSvc["Event Service & Controller<br/><i>Event Lifecycle & Public UUIDs</i>"]:::implemented

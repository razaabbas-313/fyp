    %% ========================================================================
    %% LAYER 4: AI & FACE RECOGNITION LAYER (Strategy Pattern)
    %% ========================================================================
    subgraph L4 ["LAYER 4: AI & FACE RECOGNITION LAYER (Strategy Pattern)"]
        direction TB
        AI_Strategy["&laquo;interface&raquo;<br/><b>FaceRecognitionProvider</b><br/><i>Strategy Interface: createCollection, indexPhotoFaces, searchFacesBySelfie, deleteFaces</i>"]:::implemented

        subgraph AI_Cloud ["Implementation 1: Cloud AI Provider (Active)"]
            AI_Rekognition["<b>AwsRekognitionProvider</b><br/><i>AWS Rekognition Service Integration<br/>Event-Specific Face Collections<br/>Cloud-Managed Vector Embeddings</i>"]:::implemented
        end

        subgraph AI_SelfHosted ["Implementation 2: Self-Hosted Provider (Proposed)"]
            AI_LocalEngine["<b>SelfHostedFaceRecognitionProvider</b><br/><i>InsightFace / FaceNet Engine<br/>Local Vector Similarity Search (pgvector)</i>"]:::proposed
        end

        AI_Strategy -.->|implemented by| AI_Rekognition
        AI_Strategy -.->|pluggable alternative| AI_LocalEngine
    end

    %% ========================================================================
    %% LAYER 5: DUAL-STREAM PHOTO PROCESSING PIPELINE
    %% ========================================================================
    subgraph L5 ["LAYER 5: DUAL-STREAM PHOTO PROCESSING PIPELINE"]
        direction TB
        PIPE_Trigger["Upload Confirmed (Transaction Committed)"]:::pipeline

        subgraph StreamA ["Stream A: Fast Thumbnail Indexing (Prioritized for Fast Search)"]
            A1["1. Stream Original from S3"]:::implemented
            A2["2. ThumbnailService: Resize to 1080px (JPEG 82%)"]:::implemented
            A3["3. S3StorageService: Upload Thumbnail to S3"]:::implemented
            A4["4. FaceRecognitionProvider: Index Faces on Thumbnail"]:::implemented
            A5["5. Set IndexingStatus = COMPLETED / NO_FACES"]:::implemented
            A1 --> A2 --> A3 --> A4 --> A5
        end

        subgraph StreamB ["Stream B: Background HD Archival & Self-Healing Reliability"]
            B1["1. Original HD Preserved in S3 /originals/"]:::implemented
            B2["2. PhotoRecoveryScheduler: Polls Stuck & Failed Photos"]:::implemented
            B3["3. Exponential Backoff Retry (1x, 2x, 4x up to Max Retries)"]:::implemented
            B4["4. HD Original Ready for Authenticated Downloads"]:::implemented
            B1 -.-> B2 --> B3 --> B4
        end

        PIPE_Trigger ==>|Stream A: Fast Path| A1
        PIPE_Trigger ==>|Stream B: Reliable Archival| B1
    end

    %% ========================================================================
    %% LAYER 6: CLOUD INFRASTRUCTURE & STORAGE
    %% ========================================================================
    subgraph L6 ["LAYER 6: CLOUD INFRASTRUCTURE & STORAGE"]
        direction LR
        subgraph S3_Store ["Cloud Object Storage (AWS S3 Private Bucket)"]
            S3_Originals[("<b>events/{id}/originals/</b><br/>Full-Resolution HD Images<br/><i>(Direct Presigned PUT / Auth GET)</i>")]:::datastore
            S3_Thumbnails[("<b>events/{id}/thumbnails/</b><br/>1080px Compressed Web Images<br/><i>(Gallery Feeds & Face Indexing)</i>")]:::datastore
        end

        subgraph PG_Store ["Relational Database (PostgreSQL)"]
            DB_Users[("<b>users</b><br/>id, email, password, role")]:::implemented
            DB_Events[("<b>events</b><br/>id, public_id, user_id, collection_id")]:::implemented
            DB_Photos[("<b>photos</b><br/>id, original_key, thumb_key, statuses, retry_fields")]:::implemented
            DB_Sessions[("<b>guest_sessions & photos</b><br/>session_token_hash, expires_at, matched_ids")]:::implemented
            DB_Identities[("<b>guest_identities & photos</b><br/>event_id, name, username, matched_ids")]:::implemented
            DB_Studios[("<b>studios & wallets</b><br/><i>(Proposed Multi-Tenant Schema)</i>")]:::proposed
        end

        subgraph AI_Infra ["Managed AI Services"]
            AWS_Rekognition_Colls["<b>AWS Rekognition Service</b><br/>Event Collections: <i>fotofetch_event_{publicId}</i><br/>Cloud-Managed Facial Feature Vectors"]:::implemented
            SelfHosted_Vectors["<b>pgvector / Milvus Vector Store</b><br/><i>(Proposed Self-Hosted Vector Store)</i>"]:::proposed
        end
    end

    %% ========================================================================
    %% CROSS-LAYER WORKFLOW INTERACTIONS
    %% ========================================================================

    %% Workflow A: Photographer Upload Flow
    U_Photographer -->|1. Authenticates JWT| UI_Photographer
    UI_Photographer -->|2. Selects Photos| UI_DirectUpload
    UI_DirectUpload -->|3. POST /api/events/{id}/photos/presign| BE_Presign
    BE_Presign -->|4. Generates Presigned PUT| UI_DirectUpload
    UI_DirectUpload ==>|5. Direct S3 Upload (Original HD)| S3_Originals
    UI_DirectUpload -->|6. POST /confirm| BE_Confirm
    BE_Confirm -->|7. HeadObject Check| S3_Originals
    BE_Confirm -->|8. Save Photo Record| DB_Photos
    BE_Confirm -->|9. Trigger Pipeline (afterCommit)| BE_TaskExec
    BE_TaskExec --> PIPE_Trigger
    A4 -->|IndexFacesRequest| AI_Strategy
    AI_Rekognition -->|Indexes in Collection| AWS_Rekognition_Colls

    %% Workflow B: First-Time Guest Search & Name Tagging Flow
    U_Guest -->|1. Scans Event QR Code| UI_Landing
    UI_Landing -->|2. GET /api/public/events/{publicId}| BE_EventSvc
    BE_EventSvc -->|Read Event| DB_Events
    UI_Landing -->|3. Captures Selfie| UI_SelfieSearch
    UI_SelfieSearch -->|4. POST /{publicId}/search (Selfie + Threshold)| BE_AISvc
    BE_AISvc -->|5. SearchFacesByImage| AI_Strategy
    AI_Strategy -->|SearchFaces| AWS_Rekognition_Colls
    BE_AISvc -->|6. Create GuestSession| BE_GuestSession
    BE_GuestSession -->|Store Session & Token Hash| DB_Sessions
    BE_AISvc -->|7. Return Match Thumbnails + Session Token| UI_GuestResults
    UI_GuestResults -->|8. POST /{publicId}/tag-name (Name + Token)| BE_GuestIdentity
    BE_GuestIdentity -->|9. Persistent Tagging (event, name, username, photo_ids)| DB_Identities

    %% Workflow C: Returning Guest Search Flow
    U_Guest -.->|1. Re-visits Event & Enters Name/Username| UI_NameSearch
    UI_NameSearch -.->|2. GET /{publicId}/search-by-name?query=...| BE_NameRetrieval
    BE_NameRetrieval -.->|3. Query Identity by Username/Name| DB_Identities
    BE_NameRetrieval -.->|4. Create New Authorized GuestSession| BE_GuestSession
    BE_GuestSession -.->|Save Session Token| DB_Sessions
    BE_NameRetrieval -.->|5. Return Matches & Token (No Selfie Needed)| UI_GuestResults

    %% Workflow D: HD Photo & ZIP Download Flow
    UI_GuestResults -->|1. Selects Photo(s) to Download| UI_GuestDownload
    UI_GuestDownload -->|2. GET Single Photo Download (Token + PhotoID)| BE_SingleDL
    BE_SingleDL -->|3. Validate Session & Photo Match| BE_DownloadAuth
    BE_SingleDL -->|4. Return Presigned GET URL| UI_GuestDownload
    UI_GuestDownload ==>|5. Fetch HD Original Directly| S3_Originals
    UI_GuestDownload -->|6. POST /{publicId}/photos/zip (Token + IDs)| BE_ZipService
    BE_ZipService -->|7. Validate Session & Batch IDs| BE_DownloadAuth
    BE_ZipService ==>|8. Stream HD Objects from S3| S3_Originals
    BE_ZipService ==>|9. Stream ZIP Archive (attachment)| UI_GuestDownload

# =========================================================
# FotoFetch Backend - Production Environment Variables (Render)
# =========================================================

# Database Configuration (Automatically supplied by Render PostgreSQL as DATABASE_URL)
# If using manual connection:
# SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com:5432/fotofetch
# SPRING_DATASOURCE_USERNAME=fotofetch
# SPRING_DATASOURCE_PASSWORD=your_db_password
DATABASE_URL=postgres://fotofetch:password@dpg-xxxxxx-a.oregon-postgres.render.com/fotofetch

# Server Port (Render injects PORT automatically)
PORT=10000

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication (MANDATORY in production: generate a cryptographically strong 32+ character random string)
JWT_SECRET=your_minimum_32_character_random_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# AWS Credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name

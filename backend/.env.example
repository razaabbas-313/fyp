# ===================================================
# FotoFetch AI — Backend Environment Variables
# ===================================================

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fotofetch
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Security
JWT_SECRET=fotofetch-super-secret-key-that-is-at-least-256-bits-long-for-jwt-signing-2026
JWT_EXPIRATION_MS=86400000

# AWS Credentials and Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS S3 Configuration
AWS_S3_BUCKET=your-fotofetch-s3-bucket-name
